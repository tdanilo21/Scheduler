{
  "capacity": {
    "CPU": 8,
    "RAM": 64
  },
  "targets": [],
  "nodes": [
    {
      "id": "make dir data",
      "deps": [],
      "action": {
        "type": "shell",
        "cmd": "script.cmd"
      },
      "outputs": ["data/", "data/example.txt"],
      "resources": {
        "CPU": 1,
        "RAM": 0.1
      }
    },
    {
      "id": "run A",
      "deps": ["make dir data"],
      "action": {
        "type": "c",
        "cmd": "a.c"
      },
      "outputs": ["a.exe", "data/a.txt"],
      "resources": {
        "CPU": 1,
        "RAM": 0.1
      }
    },
    {
      "id": "run B",
      "deps": ["make dir data"],
      "action": {
        "type": "python",
        "cmd": "b.py"
      },
      "outputs": ["data/b.txt"],
      "resources": {
        "CPU": 1,
        "RAM": 0.1
      }
    },
    {
      "id": "compile final",
      "deps": [],
      "action": {
        "type": "shell",
        "cmd": "gcc final.c -o final.exe"
      },
      "outputs": ["final.exe"],
      "resources": {
        "CPU": 1,
        "RAM": 0.1
      }
    },
    {
      "id": "run final",
      "deps": ["run A", "run B", "compile final"],
      "action": {
        "type": "shell",
        "cmd": "final.exe"
      },
      "outputs": ["data/final.txt"],
      "resources": {
        "CPU": 2,
        "RAM": 0.5
      }
    }
  ]
}
